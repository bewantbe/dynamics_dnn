\begin_inset Formula $\sigma_{k}$
\end_inset

 as 
\begin_inset Formula $\sigma_{k}\in[ma^{k-1},Ma^{k-1}]$
\end_inset

 .
\end_layout

\begin_layout Proof
For each matrix 
\begin_inset Formula $B$
\end_inset

,
 we denote 
\begin_inset Formula $B_{\mathrm{col}(k)}$
\end_inset

 as the 
\begin_inset Formula $k$
\end_inset

th column of 
\begin_inset Formula $B$
\end_inset

,
 then we have
\end_layout

\begin_layout Proof
\begin_inset Formula 
\[
\sigma_{k}=\left\Vert RDV_{\col(k)}\right\Vert _{2}\geq m\left\Vert DV_{\col(k)}\right\Vert _{2}\geq ma^{j-1}\left|v_{jk}\right|
\]

\end_inset


\end_layout

\begin_layout Proof
\begin_inset Formula 
\begin{equation}
\left|v_{jk}\right|\leq\frac{\sigma_{k}}{ma^{j-1}}\leq\frac{M}{m}a^{k-j}\label{eq: jk}
\end{equation}

\end_inset


\end_layout

\begin_layout Proof
Considering 
\begin_inset Formula $VV_{\col(k)}^{T}$
\end_inset

,
 we have
\end_layout

\begin_layout Proof
\begin_inset Formula 
\[
\sigma_{j}\left|v_{kj}\right|\leq\left\Vert USV^{T}VV_{\col(k)}^{T}\right\Vert _{2}=\left\Vert RDVV_{\col(k)}^{T}\right\Vert _{2}\leq M\left\Vert DVV_{\col(k)}^{T}\right\Vert _{2}\leq Ma^{k-1}
\]

\end_inset


\end_layout

\begin_layout Proof
\begin_inset Formula 
\begin{equation}
\left|v_{kj}\right|\leq\frac{M}{m}a^{k-j}\label{eq: kj}
\end{equation}

\end_inset


\end_layout

