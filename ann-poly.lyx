\begin_layout Standard
Theorems for absolutely continuous functions.
\end_layout

\begin_layout Lemma
\begin_inset Argument 1
status open

\begin_layout Plain Layout
Theorem 7.1 in 
\begin_inset CommandInset citation
LatexCommand citep
key "trefethen_approximation_2013"
literal "true"

\end_inset


\end_layout

\end_inset

 Assume 
\begin_inset Formula $f,\ldots,f^{(\nu-1)}$
\end_inset

 be absolutely continuous on 
\begin_inset Formula $[-1,1]$
\end_inset

 and 
\begin_inset Formula $f^{(\nu)}$
\end_inset

 is of bounded variation 
\begin_inset Formula $V$
\end_inset

.
 Then for 
\begin_inset Formula $\forall k\geq\nu+1$
\end_inset

, the Chebyshev coefficients of 
\begin_inset Formula $f$
\end_inset

 satisfy
\begin_inset Formula 
\[
\left|a_{k}\right|\leq\frac{2V}{\pi k(k-1)\cdots(k-\nu)}\leq\frac{2V}{\pi(k-\nu)^{\nu+1}}.
\]

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "lem:cheb-coef-cn"

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset


\end_layout

\begin_layout Lemma
\begin_inset Argument 1
status open

\begin_layout Plain Layout
Theorem 7.2 in 
\begin_inset CommandInset citation
LatexCommand citep
key "trefethen_approximation_2013"
literal "true"

\end_inset


\end_layout

\end_inset

 The same condition as Lemma 
\begin_inset CommandInset ref
LatexCommand ref
reference "lem:cheb-coef-cn"

\end_inset

, then for 
\begin_inset Formula $\forall n>\nu$
\end_inset

, its Chebyshev projections satisfy
\begin_inset Formula 
\[
\left\Vert f-f_{n}\right\Vert _{\infty}\leq\frac{2V}{\pi\nu(n-\nu)^{\nu}}
\]

\end_inset

and its Chebyshev interpolants satisfy
\begin_inset Formula 
\[
\left\Vert f-p_{n}\right\Vert _{\infty}\leq\frac{4V}{\pi\nu(n-\nu)^{\nu}}.
\]

\end_inset


\end_layout

