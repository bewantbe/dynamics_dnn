\begin_inset Formula 
\[
\left\Vert \sin\Theta(U_{1},\tilde{U}_{1})\right\Vert _{U}\leq\frac{\left\Vert (\tilde{A}-A)U_{1}\right\Vert _{U}}{\delta}
\]

