\begin_layout Title
Note of Fast Accurate Eigenvalue Computations Using The Cholesky Factorization
\end_layout

\begin_layout Standard
Theorem 2.3:
\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $G=BD\in\mathbb{R}^{n\times n}$
\end_inset

 be nonsingular and let 
\begin_inset Formula $\hat{G}=(B+\Delta B)D$
\end_inset

 where 
\begin_inset Formula $\left\Vert \Delta B\right\Vert \leq\sigma_{n}(B)$
\end_inset

.
\begin_inset Formula 
\[
\left|\frac{\sigma_{i}(\hat{G})-\sigma_{i}(G)}{\sigma_{i}(G)}\right|\leq\frac{\left\Vert \Delta B\right\Vert }{\sigma_{n}(B)},\quad i=1,\ldots,n.
\]

\end_inset


\end_layout

\begin_layout Standard
Co
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
G=L\tilde{D}^{-1}\tilde{D}
\]

\end_inset


\begin_inset Formula 
\[
\tilde{G}=(L\tilde{D}^{-1}-\Delta\tilde{D}^{-1})\tilde{D}=L_{(1)}\tilde{D}^{-1}\tilde{D}
\]

\end_inset


\begin_inset Formula 
\[
\left\Vert L\tilde{D}^{-1}\right\Vert \leq\frac{\left\Vert \Delta\tilde{D}^{-1}\right\Vert }{\sigma_{n}(L\tilde{D}^{-1})}
\]

\end_inset


\end_layout

\begin_layout Section
Derivative of eigenvalues and eigenvectors
\end_layout

\begin_layout Standard
Derivative of an eigenvalue 
\begin_inset Formula $\lambda(X)$
\end_inset

 and an eigenvector 
\begin_inset Formula $u(X)$
\end_inset

 of matrix 
\begin_inset Formula $X$
\end_inset

 at 
\begin_inset Formula $X_{0}$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset Formula $\cdot^{+}$
\end_inset

 means Moore-Penrose inverse.
\end_layout

