\begin_layout Subsection
Real symmatric case
\end_layout

\begin_layout Standard
\begin_inset Formula $X_{0}\in\mathbb{R}^{n\times n}$
\end_inset

, 
\begin_inset Formula $X_{0}=X_{0}^{T}$
\end_inset

:
\begin_inset Formula 
\[
X_{0}u_{0}=\lambda_{0}u_{0}
\]

\end_inset

 and 
\begin_inset Formula $\lambda_{0}$
\end_inset

 be a simple eigenvalue, then
\begin_inset Formula 
\[
Xu=\lambda u,\quad u^{T}u=1,\quad X\in N(X_{0})
\]

\end_inset


\begin_inset Formula 
\[
\mathrm{d}\lambda=u_{0}^{T}(\mathrm{d}X)u_{0}
\]

\end_inset


\begin_inset Formula 
\[
\mathrm{d}u=(\lambda_{0}I_{n}-X_{0})^{+}(\mathrm{d}X)u_{0}
\]

\end_inset


\end_layout

\begin_layout Subsection
General case
\end_layout

\begin_layout Subsubsection
Normalization 
\begin_inset Formula $u_{0}^{*}u=1$
\end_inset


\end_layout

\begin_layout Standard
See 
\begin_inset CommandInset citation
LatexCommand cite
key "magnus_differentiating_1985"
literal "true"

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $Z_{0}\in\mathbb{C}^{n\times n}$
\end_inset

:
\begin_inset Formula 
\[
Z_{0}u_{0}=\lambda_{0}u_{0}
\]

\end_inset

and 
\begin_inset Formula $\lambda_{0}$
\end_inset

 be simple eigenvalue, then
\begin_inset Formula 
\[
Zu=\lambda u,\quad u_{0}^{*}u=1,\quad Z\in N(Z_{0})
\]

\end_inset


\begin_inset Formula 
\[
\mathrm{d}\lambda=\frac{v_{0}^{*}(\mathrm{d}Z)u_{0}}{v_{0}^{*}u_{0}}
\]

\end_inset


\begin_inset Formula 
\begin{equation}
\mathrm{d}u=(\lambda_{0}I-Z_{0})^{+}\left(I-\frac{u_{0}v_{0}^{*}}{v_{0}^{*}u_{0}}\right)(\mathrm{d}Z)u_{0}\label{eq:dgemm-uu1-du}
\end{equation}

\end_inset

where 
\begin_inset Formula $Z_{0}^{*}v_{0}=\bar{\lambda}_{0}v_{0}$
\end_inset

, i.e.
 
\begin_inset Formula $v_{0}^{*}$
\end_inset

 is the left eigenvector of 
\begin_inset Formula $Z_{0}$
\end_inset

 corresponding to 
\begin_inset Formula $\lambda_{0}$
\end_inset

.
\end_layout

\begin_layout Subsubsection
Normalization diagC=0
\end_layout

\begin_layout Standard
See 
\begin_inset CommandInset citation
LatexCommand cite
key "giles_extended_nodate"
literal "true"

\end_inset


\end_layout

\begin_layout Standard
Assume: 
\begin_inset Formula $A\in\mathbb{C}^{n\times n}$
\end_inset

?, 
\begin_inset Formula $\lambda_{i}\neq\lambda_{j}\ \forall i\neq j$
\end_inset

.
 
\begin_inset Formula $AU=U\Lambda$
\end_inset

.
\begin_inset Formula 
\[
\mathrm{d}\Lambda=I\circ\left(U^{-1}\mathrm{d}A\,U\right)
\]

\end_inset


\end_layout

\begin_layout Standard
Normalization: 
\begin_inset Formula $\mathrm{diag}\left(U^{-1}\mathrm{d}U\right)=0$
\end_inset

:
\begin_inset Formula 
\begin{equation}
\mathrm{d}U=U\left(F\circ\left(U^{-1}\mathrm{d}A\,U\right)\right)\label{eq:dgemm-C0-du}
\end{equation}

\end_inset

where 
\begin_inset Formula $F_{ij}=(\lambda_{j}-\lambda_{i})^{-1}$
\end_inset

 for 
\begin_inset Formula $i\neq j$
\end_inset

, and zero otherwise.
\end_layout

\begin_layout Standard
In general, Eq.
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:dgemm-uu1-du"
plural "false"
caps "false"
noprefix "false"

\end_inset

 is different from Eq.
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:dgemm-C0-du"
plural "false"
caps "false"
noprefix "false"

\end_inset

.
 Eq.
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:dgemm-C0-du"
plural "false"
caps "false"
noprefix "false"

\end_inset

 seems has problem with complex conjugate roots, also it needs extra normalizati
on step to get accurate result.
\end_layout

\begin_layout Section
Derivative of SVD
\end_layout

\begin_layout Standard
See 
\begin_inset CommandInset citation
LatexCommand cite
key "giles_extended_nodate"
literal "true"

\end_inset

.
\end_layout

\begin_layout Standard
Assume 
\begin_inset Formula $A\in\mathbb{R}^{m\times n}$
\end_inset

,
\begin_inset Formula 
\[
A=USV^{T},
\]

\end_inset

then
\begin_inset Formula 
\[
\mathrm{d}S=I\circ\left(U^{T}\mathrm{d}A\,V\right).
\]

\end_inset


\end_layout

\begin_layout Standard
Assume 
\begin_inset Formula $m\leq n$
\end_inset

.
\end_layout

\begin_layout Standard
Defined 
\begin_inset Formula $\mathrm{d}C=U^{-1}\mathrm{d}U$
\end_inset

, 
\begin_inset Formula $\mathrm{d}D=V^{-1}\mathrm{d}V$
\end_inset

 (note 
\begin_inset Formula $\mathrm{d}C$
\end_inset

 and 
\begin_inset Formula $\mathrm{d}D$
\end_inset

 are anti-symmetric), and partition
\begin_inset Formula 
\[
S=\begin{bmatrix}S_{1} & 0\end{bmatrix},\quad\mathrm{d}S=\begin{bmatrix}\mathrm{d}S_{1} & 0\end{bmatrix},\quad\mathrm{d}D=\begin{bmatrix}\mathrm{d}D_{1} & -\mathrm{d}D_{2}\\
\mathrm{d}D_{2}^{T} & \mathrm{d}D_{3}
\end{bmatrix}
\]

\end_inset


\begin_inset Formula 
\[
U^{T}\mathrm{d}A\,V=\begin{bmatrix}\mathrm{d}P_{1} & \mathrm{d}P_{2}\end{bmatrix}
\]

\end_inset

then
\begin_inset Formula 
\[
\mathrm{d}D_{2}=S_{1}^{-1}\mathrm{d}P_{2}
\]

\end_inset


\begin_inset Formula 
\[
\mathrm{d}C=F\circ\left(\mathrm{d}P_{1}S_{1}+S_{1}\mathrm{d}P_{1}^{T}\right)
\]

\end_inset


\begin_inset Formula 
\[
\mathrm{d}D_{1}=F\circ\left(S_{1}\mathrm{d}P_{1}+\mathrm{d}P_{1}^{T}S_{1}\right)
\]

\end_inset

where 
\begin_inset Formula $F_{ij}=\left(s_{j}^{2}-s_{i}^{2}\right)^{-1}$
\end_inset

 for 
\begin_inset Formula $i\neq j$
\end_inset

 and zero otherwise.
\end_layout

