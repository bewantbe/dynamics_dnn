 for 
\begin_inset Formula $i\neq j$
\end_inset

 and zero otherwise.
\begin_inset Formula 
\[
\mathrm{d}U=U\left(F\circ\left(\mathrm{d}P_{1}\,S_{1}+S_{1}\mathrm{d}P_{1}^{T}\right)\right)
\]

\end_inset


\begin_inset Formula 
\[
\begin{bmatrix}\mathrm{d}V_{1}\\
\mathrm{d}V_{2}
\end{bmatrix}=V\begin{bmatrix}\mathrm{d}D_{1}\\
\mathrm{d}D_{2}^{T}
\end{bmatrix}.
\]

\end_inset


