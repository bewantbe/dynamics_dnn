\begin_layout Section
Eigenvalue bounds
\end_layout

\begin_layout Subsection
Additive perturbations
\end_layout

\begin_layout Subsubsection
Bauer-Fike-type bounds for diagonalizable matrices.
\end_layout

\begin_layout Standard
For 
\begin_inset Formula $A=X\Lambda X^{-1}$
\end_inset

(with eigenvalues 
\begin_inset Formula $\left\{ \lambda_{i}\right\} $
\end_inset

), and perturbation 
\begin_inset Formula $A+E$
\end_inset

 (with an eigenvalue 
\begin_inset Formula $\hat{\lambda}$
\end_inset

), then:
\begin_inset Formula 
\begin{equation}
\min_{i}\left|\lambda_{i}-\hat{\lambda}\right|\leq\kappa(X)\left\Vert E\right\Vert .
\end{equation}

\end_inset

where 
\begin_inset Formula $\kappa(X)$
\end_inset

 is condition number of 
\begin_inset Formula $X$
\end_inset

:
\begin_inset Formula 
\begin{equation}
\kappa(X)=\left\Vert X\right\Vert \left\Vert X^{-1}\right\Vert 
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
For relative bound (Theorem 2.1 and 2.3 in Ref.
 
\begin_inset CommandInset citation
LatexCommand cite
key "ipsen_relative_1998"
literal "false"

\end_inset

) 
\begin_inset Formula 
\begin{equation}
\min_{i}\frac{\left|\lambda_{i}-\hat{\lambda}\right|}{\left|\lambda_{i}\right|}\leq\kappa(X)\left\Vert A^{-1}E\right\Vert .
\end{equation}

\end_inset


\begin_inset Formula 
\begin{equation}
\min_{i}\frac{\left|\lambda_{i}-\hat{\lambda}\right|}{\left|\lambda_{i}\right|}\leq\kappa(X)\left\Vert A_{1}^{-1}EA_{2}^{-1}\right\Vert .
\end{equation}

\end_inset

where 
\begin_inset Formula $A=A_{1}A_{2}=A_{2}A_{1}$
\end_inset

.
\end_layout

\begin_layout Subsubsection
Whoffman-Wielandt theorem
\end_layout

\begin_layout Standard
For 
\begin_inset Formula $A=X\Lambda X^{-1}$
\end_inset

(with eigenvalues 
\begin_inset Formula $\left\{ \lambda_{i}\right\} $
\end_inset

), and perturbation 
\begin_inset Formula $A+E=\hat{X}\hat{\Lambda}\hat{X}^{-1}$
\end_inset

 (with eigenvalues 
\begin_inset Formula $\left\{ \hat{\lambda}\right\} $
\end_inset

), then:
\begin_inset Formula 
\[
\sqrt{\sum_{i=1}^{n}\left|\lambda_{i}-\hat{\lambda}_{\tau(i)}\right|^{2}}\leq\kappa(\hat{X})\kappa(X)\left\Vert E\right\Vert _{F}
\]

\end_inset

for some pertmutation 
\begin_inset Formula $\tau$
\end_inset

.
 And (Theorem 2.6 in Ref.
 
\begin_inset CommandInset citation
LatexCommand cite
key "ipsen_relative_1998"
literal "false"

\end_inset

) 
\begin_inset Formula 
\[
\sqrt{\sum_{i=1}^{n}\left(\frac{\left|\lambda_{i}-\hat{\lambda}_{\tau(i)}\right|}{\left|\lambda_{i}\right|}\right)^{2}}\leq\kappa(\hat{X})\kappa(X)\left\Vert A^{-1}E\right\Vert _{F}
\]

\end_inset


\end_layout

\begin_layout Standard
For Hermitian matrix and sort eigenvalues in descending order, then
\begin_inset Formula 
\[
\sqrt{\sum_{i=1}^{n}\left|\lambda_{i}-\hat{\lambda}_{i}\right|^{2}}\leq\left\Vert E\right\Vert _{F}
\]

\end_inset


\end_layout

\begin_layout Standard
(Theorem 2.7 in Ref.
 
\begin_inset CommandInset citation
LatexCommand cite
key "ipsen_relative_1998"
literal "false"

\end_inset

) If, in addition, 
\begin_inset Formula $A$
\end_inset

 and 
\begin_inset Formula $A+E$
\end_inset

 are Hermitian positive-definite, then
\begin_inset Formula 
\begin{equation}
\sqrt{\sum_{i=1}^{n}\frac{\left|\lambda_{i}-\hat{\lambda}_{\tau(i)}\right|^{2}}{\lambda_{i}\hat{\lambda}_{i}}}\leq\left\Vert A^{-1/2}EA^{-1/2}\left(I+A^{-1/2}EA^{-1/2}\right)^{-1/2}\right\Vert _{F}\label{eq:W-W-F}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection
Weyl-type bounds
\end_layout

\begin_layout Standard
For Hermitian matrix 
\begin_inset Formula $A$
\end_inset

 (with eigenvalues 
\begin_inset Formula $\left\{ \lambda_{i}\right\} $
\end_inset

) and 
\begin_inset Formula $A+E$
\end_inset

 (with eigenvalues 
\begin_inset Formula $\left\{ \hat{\lambda}\right\} $
\end_inset

).
\begin_inset Formula 
\[
\max_{i}\left|\lambda_{i}-\hat{\lambda}_{i}\right|\leq\left\Vert E\right\Vert .
\]

\end_inset


\end_layout

\begin_layout Standard
(Theorem 2.8 in Ref.
 
\begin_inset CommandInset citation
LatexCommand cite
key "ipsen_relative_1998"
literal "false"

\end_inset

) If further, 
\begin_inset Formula $A$
\end_inset

 is positive-definite, then
\begin_inset Formula 
\[
\max_{i}\frac{\left|\lambda_{i}-\hat{\lambda}_{i}\right|}{\left|\lambda_{i}\right|}\leq\left\Vert A^{-1/2}EA^{-1/2}\right\Vert .
\]

\end_inset


\end_layout

\begin_layout Standard
(Theorem 2.9 in Ref.
 
\begin_inset CommandInset citation
LatexCommand cite
key "ipsen_relative_1998"
literal "false"

\end_inset

) If further, 
\begin_inset Formula $A+E$
\end_inset

 is also positive-definite, then
\begin_inset Formula 
\begin{equation}
\max_{i}\frac{\left|\lambda_{i}-\hat{\lambda}_{i}\right|}{\sqrt{\lambda_{i}\hat{\lambda}_{i}}}\leq\left\Vert A^{-1/2}EA^{-1/2}\left(I+A^{-1/2}EA^{-1/2}\right)^{-1/2}\right\Vert .\label{eq:W-F}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
(Theorem 2.11 in Ref.
 
\begin_inset CommandInset citation
LatexCommand cite
key "ipsen_relative_1998"
literal "false"

\end_inset

) 
\begin_inset Formula $A$
\end_inset

 and 
\begin_inset Formula $A+E$
\end_inset

 be Hermitian.
 
\begin_inset Formula $H$
\end_inset

 is the positive-semidefinite polar factor of 
\begin_inset Formula $A$
\end_inset

 and for some 
\begin_inset Formula $0<\epsilon<1$
\end_inset


\begin_inset Formula 
\[
\left|x^{*}Ex\right|\leq\epsilon x^{*}Hx\quad\forall x
\]

\end_inset

then
\begin_inset Formula 
\[
\left|\lambda_{i}-\hat{\lambda}_{i}\right|\leq\epsilon\left|\lambda_{i}\right|.
\]

\end_inset


\end_layout

\begin_layout Standard
(Corollary 2.13 in Ref.
 
\begin_inset CommandInset citation
LatexCommand cite
key "ipsen_relative_1998"
literal "false"

\end_inset

) For 
\begin_inset Formula $A=D^{*}MD$
\end_inset

 Hermitian positive-definite and 
\begin_inset Formula $A+E=D^{*}(M+F)D$
\end_inset

 Hermitian, 
\begin_inset Formula $D$
\end_inset

 nonsingular, then
\begin_inset Formula 
\[
\max_{i}\frac{\left|\lambda_{i}-\hat{\lambda}_{i}\right|}{\left|\lambda_{i}\right|}\leq\left\Vert M^{-1/2}FM^{-1/2}\right\Vert .
\]

\end_inset

similarily, the Eq.
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:W-W-F"
plural "false"
caps "false"
noprefix "false"

\end_inset

 and Eq.
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:W-F"
plural "false"
caps "false"
noprefix "false"

\end_inset

.
\end_layout

\begin_layout Standard
(Theorem 2.19 in Ref.
 
\begin_inset CommandInset citation
LatexCommand cite
key "ipsen_relative_1998"
literal "false"

\end_inset

) Let 
\begin_inset Formula $A=DMD$
\end_inset

 and 
\begin_inset Formula $A+E=D(M+F)D$
\end_inset

 be real symmetric and 
\begin_inset Formula $D$
\end_inset

 a real nonsingular diagonal matrix.
 Among all eigenvalues of principal submatrices of 
\begin_inset Formula $M$
\end_inset

, let 
\begin_inset Formula $\mu$
\end_inset

 be the smallest in magnitude.
 If 
\begin_inset Formula $\left\Vert F\right\Vert <\left|\mu\right|$
\end_inset

 then
\begin_inset Formula 
\begin{equation}
-\left\Vert F\right\Vert \frac{2\left|\mu\right|-\left\Vert F\right\Vert }{\left|\mu\right|^{2}}\leq\frac{\hat{\lambda}_{i}-\lambda_{i}}{\lambda_{i}}\leq\left\Vert F\right\Vert \frac{2\left|\mu\right|-\left\Vert F\right\Vert }{\left(\left|\mu\right|-\left\Vert F\right\Vert \right)^{2}}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection
Ritz values
\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $A$
\end_inset

 be a Hermitian matrix of order 
\begin_inset Formula $n$
\end_inset

 and 
\begin_inset Formula $Q\in\mathbb{C}^{n\times m}$
\end_inset

, 
\begin_inset Formula $Q^{*}Q=I$
\end_inset

.
 Then 
\begin_inset Formula $W=Q^{*}AQ\in\mathbb{C}^{m\times m}$
\end_inset

, whose eigenvalues 
\begin_inset Formula $\left\{ \hat{\lambda}_{j}\right\} $
\end_inset

 are called Ritz values of 
\begin_inset Formula $A$
\end_inset

.
\end_layout

\begin_layout Standard
Define 
\begin_inset Formula $R=AQ-QW$
\end_inset

, then one can always find 
\begin_inset Formula $m$
\end_inset

 eigenvalues 
\begin_inset Formula $\left\{ \lambda_{\tau(j)}\right\} $
\end_inset

 of 
\begin_inset Formula $A$
\end_inset

, such that
\begin_inset Formula 
\begin{equation}
\max_{j}\left|\lambda_{\tau(j)}-\hat{\lambda}_{j}\right|\leq\left\Vert R\right\Vert 
\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Additive pertubations fo singular values
\end_layout

\begin_layout Standard
Assume 
\begin_inset Formula $B\in\mathbb{C}^{m\times n}$
\end_inset

, 
\begin_inset Formula $m\geq n$
\end_inset

.
\end_layout

\begin_layout Standard
(Theorem 3.2 in Ref.
 
\begin_inset CommandInset citation
LatexCommand cite
key "ipsen_relative_1998"
literal "false"

\end_inset

) If 
\begin_inset Formula $\mathrm{range}(B+F)\subset\mathrm{range}(B)$
\end_inset

, then
\begin_inset Formula 
\[
\left|\sigma_{i}-\hat{\sigma}_{i}\right|\leq\sigma_{i}\left\Vert B^{+}F\right\Vert ,\quad1\leq i\leq n.
\]

\end_inset

If 
\begin_inset Formula $\mathrm{range}((B+F)^{*})\subset\mathrm{range}(B^{*})$
\end_inset

, (or weaker, Corollary 3.3, 
\begin_inset Formula $B$
\end_inset

 is full column rank), then
\begin_inset Formula 
\[
\left|\sigma_{i}-\hat{\sigma}_{i}\right|\leq\sigma_{i}\left\Vert FB^{+}\right\Vert ,\quad1\leq i\leq n.
\]

\end_inset


\end_layout

\begin_layout Standard
(Theorem 3.9 in Ref.
 
\begin_inset CommandInset citation
LatexCommand cite
key "ipsen_relative_1998"
literal "false"

\end_inset

) Let 
\begin_inset Formula $B=D_{l}CD_{r}$
\end_inset

 and 
\begin_inset Formula $B+F=D_{l}(C+G)D_{r}$
\end_inset

 be real symmetric, where 
\begin_inset Formula $D_{l}$
\end_inset

 and 
\begin_inset Formula $D_{r}$
\end_inset

 are real nonsingular diagonal matrices.
 Among the singular values of all square submatrices of 
\begin_inset Formula $B$
\end_inset

 (?? maybe typo here), let 
\begin_inset Formula $\theta$
\end_inset

 be the smallest one.
 If 
\begin_inset Formula $\left\Vert G\right\Vert <\theta$
\end_inset

, then
\begin_inset Formula 
\begin{equation}
-\left\Vert G\right\Vert \frac{2\theta-\left\Vert G\right\Vert }{\theta^{2}}\leq\frac{\hat{\sigma}_{i}-\sigma_{i}}{\sigma_{i}}\leq\left\Vert G\right\Vert \frac{2\theta-\left\Vert G\right\Vert }{\left(\theta-\left\Vert G\right\Vert \right)^{2}}\quad\forall i
\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Graded Matrices perturbation
\end_layout

\begin_layout Standard
(Theorem 5.4 in Ref.
 
\begin_inset CommandInset citation
LatexCommand cite
key "li_relative_1998"
literal "false"

\end_inset

) Let 
\begin_inset Formula $A=S^{*}HS$
\end_inset

 and 
\begin_inset Formula $\tilde{A}=S^{*}\tilde{H}S$
\end_inset

 be two 
\begin_inset Formula $n\times n$
\end_inset

 nonnegative definite Hermitian matrices with eigenvalues ordered descendingly,
 let 
\begin_inset Formula $\Delta H=\tilde{H}-H$
\end_inset

.
 If 
\begin_inset Formula $\left\Vert H^{-1}\right\Vert \left\Vert \Delta H\right\Vert <1$
\end_inset

, then
\begin_inset Formula 
\[
\max_{i}\chi(\lambda_{i},\tilde{\lambda}_{i})\leq\frac{\left\Vert H^{-1}\right\Vert \left\Vert \Delta H\right\Vert }{\sqrt{1-\left\Vert H^{-1}\right\Vert \left\Vert \Delta H\right\Vert }}
\]

\end_inset


\begin_inset Formula 
\[
\sqrt{\sum_{i=1}^{n}\left(\chi(\lambda_{i},\tilde{\lambda}_{i})\right)^{2}}\leq\frac{\left\Vert H^{-1}\right\Vert \left\Vert \Delta H\right\Vert _{F}}{\sqrt{1-\left\Vert H^{-1}\right\Vert \left\Vert \Delta H\right\Vert }}
\]

\end_inset

where (also define 
\begin_inset Formula $0/0=0$
\end_inset

)
\begin_inset Formula 
\[
\chi(a,\tilde{a})=\frac{\left|a-\tilde{a}\right|}{\sqrt{a\tilde{a}}}.
\]

\end_inset


\end_layout

\begin_layout Standard
(Theorem 5.5 in Ref.
 
\begin_inset CommandInset citation
LatexCommand cite
key "li_relative_1998"
literal "false"

\end_inset

) Let 
\begin_inset Formula $B=GS$
\end_inset

 and 
\begin_inset Formula $\tilde{B}=\tilde{GS}$
\end_inset

 be two 
\begin_inset Formula $n\times n$
\end_inset

 matrices with singular values ordered descendingly, 
\begin_inset Formula $G$
\end_inset

 and 
\begin_inset Formula $\tilde{G}$
\end_inset

 are nonsingular, let 
\begin_inset Formula $\Delta G=\tilde{G}-G$
\end_inset

.
 If 
\begin_inset Formula $\left\Vert \Delta G\right\Vert \left\Vert G^{-1}\right\Vert <1$
\end_inset

, then
\begin_inset Formula 
\[
\max_{i}\chi(\sigma_{i},\tilde{\sigma}_{i})\leq\left(1+\frac{1}{1-\left\Vert G^{-1}\right\Vert \left\Vert \Delta G\right\Vert }\right)\frac{\left\Vert G^{-1}\right\Vert \left\Vert \Delta G\right\Vert }{2}
\]

\end_inset


\begin_inset Formula 
\[
\sqrt{\sum_{i=1}^{n}\left(\chi(\sigma_{i},\tilde{\sigma}_{i})\right)^{2}}\leq\left(1+\frac{1}{1-\left\Vert G^{-1}\right\Vert \left\Vert \Delta G\right\Vert }\right)\frac{\left\Vert G^{-1}\right\Vert \left\Vert \Delta G\right\Vert _{F}}{2}.
\]

\end_inset


\end_layout

\begin_layout Standard
(Theorem 7.5 in Ref.
 
\begin_inset CommandInset citation
LatexCommand cite
key "li_relative_1998"
literal "false"

\end_inset

) Under the conditions above, we have 
\begin_inset Formula 
\[
\frac{\left|\tilde{\lambda}_{j}-\lambda_{j}\right|}{\lambda_{j}}\leq\left\Vert H^{-1}\right\Vert \left\Vert \Delta H\right\Vert \quad\forall j,
\]

\end_inset


\begin_inset Formula 
\[
\frac{\left|\tilde{\sigma}_{j}-\sigma_{j}\right|}{\sigma_{j}}\leq\left\Vert G^{-1}\right\Vert \left\Vert \Delta G\right\Vert \quad\forall j.
\]

\end_inset


\end_layout

