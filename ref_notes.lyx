\begin_layout Standard
(Theorem 3.2 in Ref.
 
\begin_inset CommandInset citation
LatexCommand cite
key "li_relative_1998"
literal "false"

\end_inset

 (Davis-Kahan)) Let 
\begin_inset Formula $A$
\end_inset

 and 
\begin_inset Formula $\tilde{A}$
\end_inset

 be two Hermitian matrices.Assume there is an interval 
\begin_inset Formula $\left[\alpha,\beta\right]$
\end_inset

 and a 
\begin_inset Formula $\delta>0$
\end_inset

 such that the spectrum of 
\begin_inset Formula $\Lambda_{1}$
\end_inset

 lies entirely in 
\begin_inset Formula $\left[\alpha,\beta\right]$
