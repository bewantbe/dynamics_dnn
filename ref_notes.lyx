\begin_layout Section
Derivative of Cholesky decomposition
\end_layout

\begin_layout Standard
Suppose 
\begin_inset Formula $\Sigma=\Sigma^{T}\in\mathbb{R}^{n\times n}$
\end_inset

,
\begin_inset Formula 
\[
LL^{T}=\Sigma
\]

\end_inset

with perturbation 
\begin_inset Formula $\mathrm{d}\Sigma=\mathrm{d}\Sigma^{T}$
\end_inset

, then
\begin_inset Formula 
\[
\mathrm{d}L=L\,\Phi(L^{-1}\mathrm{d}\Sigma\left(L^{-1}\right)^{T}),
\]

\end_inset

where the 
\begin_inset Formula $\Phi$
\end_inset

 operator extract the lower-triangular part of a matrix and halves its diagonal:
\begin_inset Formula 
\[
\Phi_{ij}(A)=\begin{cases}
A_{ij} & i>j\\
\frac{1}{2}A_{ii} & i=j\\
0 & i<j
\end{cases}.
\]

\end_inset


\end_layout

