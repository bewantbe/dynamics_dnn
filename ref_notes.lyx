\begin_layout Standard
Suppose 
\begin_inset Formula $x\in\mathbb{R}^{n\times1}$
\end_inset


\begin_inset Formula 
\[
y=\frac{x}{\left\Vert x\right\Vert },
\]

\end_inset

then
\begin_inset Formula 
\[
\mathrm{d}y=\left(I-\frac{xx^{T}}{\left\Vert x\right\Vert ^{2}}\right)\frac{\mathrm{d}x}{\left\Vert x\right\Vert }.
\]

\end_inset


\end_layout

\begin_layout Standard
For vector 
\begin_inset Formula $z\in\mathbb{C}^{n\times1}$
\end_inset

.
\end_layout

\begin_layout Standard
A convention used in autograd (Ref.
 
\begin_inset CommandInset citation
LatexCommand cite
key "maclaurin_efficiently_2019"
literal "true"

\end_inset

):
\begin_inset Formula 
\[
f(z)=u(\mathrm{Re}(z),\mathrm{Im}(z))+\mathrm{i}vu(\mathrm{Re}(z),\mathrm{Im}(z)),
\]

\end_inset

the derivative is defined by
\begin_inset Formula 
\[
\frac{\mathrm{d}f(z)}{\mathrm{d}z}=\frac{\partial u}{\partial x}(\mathrm{Re}(z),\mathrm{Im}(z))-\mathrm{i}\frac{\partial u}{\partial y}(\mathrm{Re}(z),\mathrm{Im}(z)).
\]

\end_inset


\end_layout

\begin_layout Standard
Under this definition
\begin_inset Formula 
\[
\frac{\mathrm{d}}{\mathrm{d}z}\frac{z}{\sqrt{z^{*}z}}=\frac{1}{\sqrt{z^{*}z}}-\frac{z}{2}\left(z^{*}z\right)^{-\frac{3}{2}}\frac{\mathrm{d}}{\mathrm{d}z}\left(z^{*}z\right)
\]

\end_inset

where
\begin_inset Formula 
\[
u(x,y)=x^{2}+y^{2}
\]

\end_inset


\begin_inset Formula 
\[
\frac{\mathrm{d}}{\mathrm{d}z}\left(z^{*}z\right)=2\mathrm{Re}(z^{T})-2\mathrm{i}\mathrm{Im}(z^{T})=2z^{*}
\]

\end_inset


\end_layout

\begin_layout Standard
Thus
\begin_inset Formula 
\[
\frac{\mathrm{d}}{\mathrm{d}z}\frac{z}{\sqrt{z^{*}z}}=\frac{1}{\left\Vert z\right\Vert }\left(I-\frac{zz^{*}}{\left\Vert z\right\Vert ^{2}}\right)
\]

\end_inset


\end_layout

\begin_layout Section
Grönwall's inequality
\end_layout

\begin_layout Standard
If
\begin_inset Formula 
\[
u'(t)\leq\beta(t)u(t),\quad\forall t\in(a,b)
\]

\end_inset

then
\begin_inset Formula 
\[
u(t)\leq u(a)\exp(\int_{a}^{t}\beta(s)\,\mathrm{d}s)
\]

\end_inset


\end_layout

\begin_layout Section
Taylor's theorem
\end_layout

\begin_layout Standard
For Taylor series
\begin_inset Formula 
\[
f(x)=\sum_{j=0}^{k}\frac{f^{(j)}(a)}{j!}(x-a)^{j}+R_{k}(x).
\]

\end_inset


\end_layout

\begin_layout Standard
Lagrange form of the remainder, 
\begin_inset Formula $\exists\xi_{L}\in[a,x]$
\end_inset


\begin_inset Formula 
\[
R_{k}(x)=\frac{f^{(k+1)}(\xi_{L})}{(k+1)!}(x-a)^{k+1}.
\]

\end_inset


\end_layout

\begin_layout Standard
Cauchy form of the remainder, 
\begin_inset Formula $\exists\xi_{C}\in[a,x]$
\end_inset


\begin_inset Formula 
\[
R_{k}(x)=\frac{f^{(k+1)}(\xi_{C})}{k!}(x-\xi_{C})^{k}(x-a).
\]

\end_inset


\end_layout

\begin_layout Standard
General form: for 
\begin_inset Formula $G\in C^{1}([a,x])$
\end_inset

, and 
\begin_inset Formula $G'(t)\neq0,\forall t\in(a,x)$
\end_inset

, 
\begin_inset Formula $\exists\xi\in[a,x]$
\end_inset


\begin_inset Formula 
\[
R_{k}(x)=\frac{f^{(k+1)}(\xi)}{k!}(x-\xi)^{k}\frac{G(x)-G(a)}{G'(\xi)}.
\]

\end_inset


\end_layout

\begin_layout Standard
Integral form of the remainder: 
\begin_inset Formula $f^{(k)}$
\end_inset

 be absolutely continuous on 
\begin_inset Formula $[a,x]$
\end_inset


\begin_inset Formula 
\[
R_{k}(x)=\int_{a}^{x}\frac{f^{(k+1)}(t)}{k!}(x-t)^{k}\mathrm{d}t.
\]

\end_inset


\end_layout

\begin_layout Standard
Remainder in complex analysis:
\begin_inset Formula 
\[
R_{k}(z)=\frac{(z-a)^{k+1}}{2\pi\mathrm{i}}\int_{\partial\Omega}\frac{f(s)\,\mathrm{d}s}{(s-a)^{k+1}(s-z)}
\]

\end_inset

with bounds for 
\begin_inset Formula $z\in\Omega=\{s\in\mathbb{C}|\left|s-a\right|\leq r\}$
\end_inset


\begin_inset Formula 
\[
\left|f^{(k)}(z)\right|\leq\frac{k!M_{r}}{r^{k}},\quad M_{r}=\max_{\left|s-a\right|=r}\left|f(s)\right|
\]

\end_inset


\begin_inset Formula 
\[
R_{k}(z)\leq\frac{\beta^{k+1}M_{r}}{1-\beta},\quad\beta=\frac{\left|z-a\right|}{r}<1
\]

\end_inset


\end_layout

