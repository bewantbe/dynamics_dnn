\begin_layout Subsection
Real symmetric case
\end_layout

\begin_layout Standard
\begin_inset Formula $X_{0}\in\mathbb{R}^{n\times n}$
\end_inset

, 
\begin_inset Formula $X_{0}=X_{0}^{T}$
\end_inset

:
\begin_inset Formula 
\[
X_{0}u_{0}=\lambda_{0}u_{0}
\]

\end_inset

 and 
\begin_inset Formula $\lambda_{0}$
\end_inset

 be a simple eigenvalue, then
\begin_inset Formula 
\[
Xu=\lambda u,\quad u^{T}u=1,\quad X\in N(X_{0})
\]

\end_inset


\begin_inset Formula 
\[
\mathrm{d}\lambda=u_{0}^{T}(\mathrm{d}X)u_{0}
\]

\end_inset


\begin_inset Formula 
\[
\mathrm{d}u=(\lambda_{0}I_{n}-X_{0})^{+}(\mathrm{d}X)u_{0}.
\]

\end_inset


\end_layout

\begin_layout Standard
Note that 
\begin_inset Formula $X_{0}=U_{0}\Lambda_{0}U_{0}^{T}$
\end_inset

, so
\begin_inset Formula 
\[
\mathrm{d}u=U_{0}\left(\lambda_{0}I_{n}-\Lambda_{0}\right)^{+}U_{0}^{T}(\mathrm{d}X)u_{0},
\]

\end_inset

which is a specific column of Eq.
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:dgemm-C0-du"
plural "false"
