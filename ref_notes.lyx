\begin_layout Standard
In the exponential cases
\begin_inset Formula 
\[
\left|a_{kl}\right|\leq C_{0}\rho^{-k},\quad\forall k,l\geq0
\]

\end_inset


\begin_inset Formula 
\[
\left|K_{jk}\right|\leq C_{0}L\rho^{-j-k}.
\]

\end_inset


\end_layout

\begin_layout Standard
Approx
\begin_inset Formula 
\[
(\lambda_{j}-\lambda_{i})^{-1}\sim\left(C_{0}L\right)^{-1}\left(\rho^{-2j}-\rho^{-2i}\right)^{-1}
\]

\end_inset


\begin_inset Formula 
\begin{align*}
\left(F\circ(A-\mathrm{diag}(A))\right)_{ij} & \sim\left(C_{0}L\right)^{-1}\left(\rho^{-2j}-\rho^{-2i}\right)^{-1}C_{0}L\rho^{-i-j}\\
 & =\left(\rho^{-2j}-\rho^{-2i}\right)^{-1}\rho^{-i-j}\\
 & =\begin{cases}
\rho^{j-i} & j\ll i\\
-\rho^{i-j} & i\ll j
\end{cases}
\end{align*}

\end_inset


\end_layout

