\begin_layout Standard
\begin_inset Formula 
\[
\mathrm{d}u=U_{0}\left(\lambda_{0}I_{n}-\Lambda_{0}\right)^{+}U_{0}^{T}(\mathrm{d}X)u_{0},
\]

\end_inset

the graded matrix expansion
\begin_inset Formula 
\[
\mathrm{d}u=\left(\lambda_{0}I_{n}-\Lambda_{0}\right)^{+}(A-\mathrm{diag}(A))u_{0}
\]

\end_inset


\end_layout

\begin_layout Standard
Or
\begin_inset Formula 
\[
\mathrm{d}U=F\circ(A-\mathrm{diag}(A))
\]

\end_inset

where 
\begin_inset Formula $F_{ij}=(\lambda_{j}-\lambda_{i})^{-1}$
\end_inset

 for 
\begin_inset Formula $i\neq j$
\end_inset

, and zero otherwise.
