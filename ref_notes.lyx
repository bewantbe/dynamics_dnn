where
\begin_inset Formula 
\[
A=U\Lambda U^{*}=\begin{bmatrix}U_{1} & U_{2}\end{bmatrix}\begin{bmatrix}\Lambda_{1}\\
 & \Lambda_{2}
\end{bmatrix}\begin{bmatrix}U_{1}^{*}\\
U_{2}^{*}
\end{bmatrix}
\]

\end_inset


\begin_inset Formula 
\[
\tilde{A}=\tilde{U}\tilde{\Lambda}\tilde{U}^{*}=\begin{bmatrix}\tilde{U}_{1} & \tilde{U}_{2}\end{bmatrix}\begin{bmatrix}\tilde{\Lambda}_{1}\\
 & \tilde{\Lambda}_{2}
\end{bmatrix}\begin{bmatrix}\tilde{U}_{1}^{*}\\
\tilde{U}_{2}^{*}
\end{bmatrix}.
\]

\end_inset


