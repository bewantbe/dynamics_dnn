\begin_body

\begin_layout Title
Gradient Descent Dynamics of 1-Hidden Layer DNN
\end_layout

\begin_layout Section
Reformulation of Gradient Descent in Generalized Fourier Series (GFS)
\end_layout

\begin_layout Subsection
The 2-norm Loss and Derived Generalized Fourier Series Expansion
\end_layout

\begin_layout Standard
The problem setup is to fit 
\begin_inset Formula $J$
\end_inset

 given pairs of feature and label (inputs and outputs) 
\begin_inset Formula $\left\{ \left(x_{j},y_{j}\right)\right\} $
\end_inset

 by a function 
\begin_inset Formula $\Upsilon_{\theta}(x)$
\end_inset

 with parameter 
\begin_inset Formula $\theta$
\end_inset

 (usually a vector).
 Without loss of generality, we limit the range of 
\begin_inset Formula $x_{j}$
\end_inset

 to 
\begin_inset Formula $[-1,1]$
\end_inset

.
 Generalize to high dimensional 
\begin_inset Formula $x_{j}\in[-1,1]^{d}$
\end_inset

 is under consideration.
\end_layout

\begin_layout Standard
We have the 2-norm loss for the error of the fitting:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\tilde{L}_{J}(\theta)=\frac{1}{2J}\sum_{j=1}^{J}\left(\Upsilon_{\theta}(x_{j})-y_{j}\right)^{2}.\label{eq:Loss-sample}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Assume the samples 
\begin_inset Formula $\left\{ x_{j}\right\} $
\end_inset

 are draw from a distribution 
\begin_inset Formula $\rho(x)$
\end_inset

, and the labels are come from an underlying function 
\begin_inset Formula $y(x)$
\end_inset

: 
\begin_inset Formula $y_{j}=y(x_{j})$
\end_inset

, 
\begin_inset Formula $y(x)$
\end_inset

 is .
 Now let 
\begin_inset Formula $J\rightarrow\infty$
\end_inset

, we should have a theoretical loss 
\begin_inset Formula $L(\theta)$
\end_inset

:
\begin_inset Formula 
\begin{equation}
L(\theta)=\frac{1}{2}\int_{\Omega}\left(\Upsilon_{\theta}(x)-y(x)\right)^{2}\rho(x)\,\mathrm{d}x.\label{eq:Loss}
\end{equation}

\end_inset


\begin_inset Formula 
\[
\tilde{L}_{J}(\theta)\rightarrow L(\theta)\quad\mathrm{as}\ J\rightarrow\infty,
\]

\end_inset


\end_layout

\begin_layout Standard
The Eq.
 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:Loss"

\end_inset

 naturally induced a norm and an inner product (assume all real functions)
\begin_inset Formula 
\begin{equation}
\left\Vert f\right\Vert _{\rho}=\int_{\Omega}f^{2}(x)\rho(x)\,\mathrm{d}x,
\end{equation}

\end_inset


\begin_inset Formula 
\begin{equation}
\left\langle f,g\right\rangle _{\rho}=\int_{\Omega}f(x)g(x)\rho(x)\,\mathrm{d}x.\label{eq:inner-product}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Under the inner product in Eq.
 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:inner-product"

\end_inset

, there exist a set of orthonomal polynomial basis 
\begin_inset Formula $\left\{ p_{k}(x)\right\} _{k=0}^{\infty}$
\end_inset

 where 
\begin_inset Formula $p_{k}(x)$
\end_inset

 is a polynomial of order 
\begin_inset Formula $k$
\end_inset

:
\begin_inset Formula 
\begin{equation}
\left\langle p_{k},p_{j}\right\rangle _{\rho}=\delta_{kj}.
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
In 1-D case, each 
\begin_inset Formula $p_{k}(x)$
\end_inset

 has exactly 
\begin_inset Formula $k$
\end_inset

 zeros.
 Therefore the subscript 
\begin_inset Formula $k$
\end_inset

 has similar meaning as the 
\begin_inset Formula $k$
\end_inset

 in Fourier mode 
\begin_inset Formula $e^{\mathrm{i}kx}$
\end_inset

, i.e.
 the frequency.
\end_layout

\begin_layout Standard
If 
\begin_inset Formula $\rho(x)>0$
\end_inset

 almost everywhere, then 
\begin_inset Formula $\left\{ p_{k}(x)\right\} _{k=0}^{\infty}$
\end_inset

 is a complete basis 
\begin_inset Foot
status open

\begin_layout Plain Layout
TODO: ref
\end_layout

\end_inset

 with the same convergence trends as Chebyshev approximation.
 
\begin_inset Foot
status open

\begin_layout Plain Layout
TODO: ref
\end_layout

\end_inset


\end_layout

\begin_layout Standard
The fitting function 
\begin_inset Formula $\Upsilon_{\theta}$
\end_inset

, if piecewise continuous, can be expanded in Generalized Fourier Series
 (GFS):
\begin_inset Formula 
\begin{equation}
\Upsilon_{\theta}(x)=\sum_{k=0}^{\infty}c_{k}(\theta)p_{k}(x)\quad\textrm{(a.e.)}\label{eq:orth-expand}
\end{equation}

\end_inset


\begin_inset Formula 
\begin{equation}
c_{k}(\theta)=\left\langle \Upsilon_{\theta},p_{k}\right\rangle _{\rho}\label{eq:expand-coef}
\end{equation}

\end_inset

where (a.e.) here means (equal) almost everywhere.
 If 
\begin_inset Formula $\Upsilon_{\theta}(x)$
\end_inset

 is continuous, then it is pointwise equal.
 In later context we will denote both cases by simply equal 
\begin_inset Quotes eld
\end_inset

=
\begin_inset Quotes erd
\end_inset

.
\end_layout

\begin_layout Subsection
Effectiveness of GFS in Representing Smooth Functions
\begin_inset CommandInset label
LatexCommand label
name "subsec:Effectiveness-of-GFS"

\end_inset


\end_layout

\begin_layout Standard
See Ref.
 
\begin_inset CommandInset citation
LatexCommand citep
key "gottlieb_numerical_1977,trefethen_approximation_2013"

\end_inset

.
 Here list only theorems for Chebyshev polynomials.
\end_layout

\begin_layout Subsubsection
Chebyshev Approximations
\end_layout

\begin_layout Standard
Theorems for absolutely continuous functions.
\end_layout

\begin_layout Lemma
\begin_inset Argument 1
status open

\begin_layout Plain Layout
Theorem 7.1 in 
\begin_inset CommandInset citation
LatexCommand citep
key "trefethen_approximation_2013"

\end_inset


\end_layout

\end_inset

 Assume 
\begin_inset Formula $f,\ldots,f^{(\nu-1)}$
\end_inset

 be absolutely continuous on 
\begin_inset Formula $[-1,1]$
\end_inset

 and 
\begin_inset Formula $f^{(\nu)}$
\end_inset

 is of bounded variation 
\begin_inset Formula $V$
\end_inset

.
 Then for 
\begin_inset Formula $\forall k\geq\nu+1$
\end_inset

, the Chebyshev coefficients of 
\begin_inset Formula $f$
\end_inset

 satisfy
\begin_inset Formula 
\[
\left|a_{k}\right|\leq\frac{2V}{\pi k(k-1)\cdots(k-\nu)}\leq\frac{2V}{\pi(k-\nu)^{\nu+1}}.
\]

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "lem:cheb-coef-cn"

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset


\end_layout

\begin_layout Lemma
\begin_inset Argument 1
status open

\begin_layout Plain Layout
Theorem 7.2 in 
\begin_inset CommandInset citation
LatexCommand citep
key "trefethen_approximation_2013"

\end_inset


\end_layout

\end_inset

 The same condition as Lemma 
\begin_inset CommandInset ref
LatexCommand ref
reference "lem:cheb-coef-cn"

\end_inset

, then for 
\begin_inset Formula $\forall n>\nu$
\end_inset

, its Chebyshev projections satisfy
\begin_inset Formula 
\[
\left\Vert f-f_{n}\right\Vert _{\infty}\leq\frac{2V}{\pi\nu(n-\nu)^{\nu}}
\]

\end_inset

and its Chebyshev interpolants satisfy
\begin_inset Formula 
\[
\left\Vert f-p_{n}\right\Vert _{\infty}\leq\frac{4V}{\pi\nu(n-\nu)^{\nu}}.
\]

\end_inset


\end_layout

\begin_layout Standard
Theorems for analytical functions.
\end_layout

\begin_layout Lemma
\begin_inset Argument 1
status open

\begin_layout Plain Layout
Theorem 8.1 in 
\begin_inset CommandInset citation
LatexCommand citep
key "trefethen_approximation_2013"

\end_inset


\end_layout

\end_inset

 Assume 
\begin_inset Formula $f$
\end_inset

 analytic in 
\begin_inset Formula $[-1,1]$
\end_inset

 be analytically continuable to the open Bernstein ellipse 
\begin_inset Formula $E_{\rho}$
\end_inset

 (note 
\begin_inset Foot
status open

\begin_layout Plain Layout
Bernstein ellipse 
\begin_inset Formula $E_{\rho}$
\end_inset

: foci 1 and -1 with semimajor and semiminor axis lengths summing to 
\begin_inset Formula $\rho$
\end_inset

 in complex plane.
\end_layout

\end_inset

), where it satisfies 
\begin_inset Formula $\left|f(x)\right|\leq M$
\end_inset

 for some 
\begin_inset Formula $M$
\end_inset

.
 Then its Chebyshev coefficients satisfy 
\begin_inset Formula $\left|a_{0}\right|\leq M$
\end_inset

 and
\begin_inset Formula 
\[
\left|a_{k}\right|\leq2M\rho^{-k},\quad k\geq1.
\]

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "lem:cheb-coef-analytical"

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset


\end_layout

\begin_layout Lemma
\begin_inset Argument 1
status open

\begin_layout Plain Layout
Theorem 8.2 in 
\begin_inset CommandInset citation
LatexCommand citep
key "trefethen_approximation_2013"

\end_inset


\end_layout

\end_inset

 The same condition as Lemma 
\begin_inset CommandInset ref
LatexCommand ref
reference "lem:cheb-coef-analytical"

\end_inset

, then for 
\begin_inset Formula $\forall n\geq0$
\end_inset

 its Chebyshev projections satisfy
\begin_inset Formula 
\[
\left\Vert f-f_{n}\right\Vert _{\infty}\leq\frac{2M\rho^{-n}}{\rho-1}
\]

\end_inset

and its Chebyshev interpolants satisfy
\begin_inset Formula 
\[
\left\Vert f-p_{n}\right\Vert _{\infty}\leq\frac{4M\rho^{-n}}{\rho-1}.
\]

\end_inset


\end_layout

\begin_layout Subsection
Evolution of GFS in Gradient Descent
\end_layout

\begin_layout Standard
The evolution of parameter 
\begin_inset Formula $\theta$
\end_inset

 depends on the gradient of loss.
 In terms of GFS, the gradient can be written as:
\begin_inset Formula 
\begin{align}
\frac{\partial L(\theta)}{\partial\theta} & =\frac{1}{2}\frac{\partial}{\partial\theta}\left\langle \Upsilon_{\theta}-y,\Upsilon_{\theta}-y\right\rangle _{\rho}=\frac{1}{2}\frac{\partial}{\partial\theta}\sum_{k=0}^{\infty}\left\langle \Upsilon_{\theta}-y,p_{k}\right\rangle _{\rho}^{2}=\sum_{k=0}^{\infty}\left\langle \Upsilon_{\theta}-y,p_{k}\right\rangle _{\rho}\frac{\partial}{\partial\theta}\left\langle \Upsilon_{\theta},p_{k}\right\rangle _{\rho}\nonumber \\
 & =\sum_{k=0}^{\infty}\left(c_{k}(\theta)-\hat{y}_{k}\right)\frac{\partial c_{k}(\theta)}{\partial\theta},\label{eq:Loss-d}
\end{align}

\end_inset

where
\begin_inset Formula 
\begin{equation}
\hat{y}_{k}=\left\langle y,p_{k}\right\rangle _{\rho}\quad k=0,1,\ldots
\end{equation}

\end_inset


\begin_inset Formula 
\begin{equation}
\frac{\partial c_{k}(\theta)}{\partial\theta}=\left\langle \frac{\partial\Upsilon_{\theta}}{\partial\theta},p_{k}\right\rangle _{\rho}.\label{eq:ck-derivative}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The trajactory of 
\begin_inset Formula $\theta(t)$
\end_inset

 in gradient descent (GD) algorithm can be rewritten in ODE as a limit of
 small step size:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\frac{\mathrm{d}\theta}{\mathrm{d}t}=-\alpha\left[\frac{\partial L(\theta)}{\partial\theta}\right]^{T},\label{eq:theta-time}
\end{equation}

\end_inset

where 
\begin_inset Formula $\alpha$
\end_inset

 is the learning rate, 
\begin_inset Formula $\cdot^{T}$
\end_inset

 means transpose of the Jacobian matrix inside.
 And
\begin_inset Formula 
\[
\left[\frac{\partial L(\theta)}{\partial\theta}\right]=\begin{bmatrix}\frac{\partial L(\theta)}{\partial\theta_{1}} & \frac{\partial L(\theta)}{\partial\theta_{2}} & \cdots\end{bmatrix}.
\]

\end_inset


\end_layout

\begin_layout Standard
The dynamics of the GFS coefficients 
\begin_inset Formula $c_{k}(\theta(t))$
\end_inset

 can be derived with help of Eq.
 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:Loss-d"

\end_inset

 and Eq.
 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:theta-time"

\end_inset

:
\begin_inset Formula 
\begin{align}
\frac{\mathrm{d}(c_{k}(\theta(t))-\hat{y}_{k})}{\mathrm{d}t} & =\frac{\partial c_{k}(\theta)}{\partial\theta}\cdot\frac{\mathrm{d}\theta}{\mathrm{d}t}\nonumber \\
 & =-\alpha\sum_{k'=0}^{\infty}\left[\frac{\partial c_{k}(\theta)}{\partial\theta}\right]\left[\frac{\partial c_{k'}(\theta)}{\partial\theta}\right]^{T}(c_{k'}(\theta)-\hat{y}_{k'}),\quad k=0,1,\ldots.\label{eq:coef-dym}
\end{align}

\end_inset


\end_layout

\begin_layout Standard
Note that, formally, a system of linear equation
\begin_inset Formula 
\begin{equation}
\frac{\mathrm{d}\vec{r}}{\mathrm{d}t}=-\alpha H\vec{r},\label{eq:linear-dym}
\end{equation}

\end_inset

has solution Eq.
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:linear-solution"

\end_inset

, (assume 
\begin_inset Formula $A$
\end_inset

 is constant here):
\begin_inset Formula 
\begin{equation}
\vec{r}(t)=e^{-\alpha At}\vec{C}=Pe^{-\alpha\Lambda t}P^{-1}\vec{C},\label{eq:linear-solution}
\end{equation}

\end_inset


\begin_inset Formula 
\begin{equation}
H=P\Lambda P^{-1},
\end{equation}

\end_inset

where 
\begin_inset Formula $\vec{C}$
\end_inset

 is an arbitrary constant vector.
\end_layout

\begin_layout Standard
It is clear that the eigenvalues of 
\begin_inset Formula $H$
\end_inset

 govern the dynamics of Eq.
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:linear-dym"

\end_inset

.
\end_layout

\begin_layout Standard
With substitution
\begin_inset Formula 
\begin{equation}
\vec{r}(t)=\left[c_{k}(\theta(t))-\left\langle y,p_{k}\right\rangle _{\rho}\right]_{k\in\mathbb{N}_{0}},
\end{equation}

\end_inset


\begin_inset Formula 
\begin{equation}
H=H_{c(\theta)}\triangleq\left[\frac{\partial c_{k}(\theta)}{\partial\theta}\right]_{k\in\mathbb{N}_{0}}\left[\frac{\partial c_{k}(\theta)}{\partial\theta}\right]_{k\in\mathbb{N}_{0}}^{T},\label{eq:H-evolve-matrix}
\end{equation}

\end_inset

where 
\begin_inset Formula $\left[\cdot\right]_{k\in\mathbb{N}_{0}}$
\end_inset

 means vertically stack the terms indexed by 
\begin_inset Formula $k$
\end_inset

 to form a possibly infinite sized matrix.
 e.g.
\begin_inset Formula 
\[
\left[\frac{\partial c_{k}(\theta)}{\partial\theta}\right]_{k\in\mathbb{N}_{0}}=\begin{bmatrix}\frac{\partial c_{0}(\theta)}{\partial\theta_{1}} & \frac{\partial c_{0}(\theta)}{\partial\theta_{2}} & \cdots\\
\frac{\partial c_{1}(\theta)}{\partial\theta_{1}} & \frac{\partial c_{1}(\theta)}{\partial\theta_{2}}\\
\vdots &  & \ddots
\end{bmatrix}.
\]

\end_inset


\end_layout

\begin_layout Standard
We see the study of eigenvalues could greatly helps the understanding of
 Eq.
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:coef-dym"

\end_inset

, despite 
\begin_inset Formula $H_{c(\theta)}$
\end_inset

 is now time dependent.
 Now we turn to the analysis of matrix 
\begin_inset Formula $H_{c(\theta)}$
\end_inset

.
\end_layout

\begin_layout Section
Structure of the matrix 
\begin_inset Formula $H$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $A$
\end_inset

 is an 
\begin_inset Formula $\infty\times\infty$
\end_inset

 matrix, for simplicity, assume it is finitely truncated.
 The truncation is reasonable due to the fast decaying property of 
\begin_inset Formula $c_{k}(\theta)$
\end_inset

 .
 Analysis of the infinite dimension problem directly is under concideration.
\end_layout

\begin_layout Standard
Now we need the detailed form of 
\begin_inset Formula $\Upsilon_{\theta}(x)$
\end_inset

 to investigate the structure of the matrix 
\begin_inset Formula $H$
\end_inset

.
\end_layout

\begin_layout Subsection
1-Hidden Layer DNN
\end_layout

\begin_layout Standard
The 1-Hidden Layer DNN with parameter 
\begin_inset Formula $\theta=\{a_{l},w_{l},b_{l}\}$
\end_inset


\begin_inset Formula $_{l=1}^{L}$
\end_inset

 and input range 
\begin_inset Formula $x\in[-1,1]$
\end_inset

 is: 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\Upsilon_{\theta}(x)\triangleq\sum_{l=1}^{L}a_{l}\sigma(w_{l}x+b_{l}).\label{eq:1-layer-ann}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Matrix 
\begin_inset Formula $H$
\end_inset

 of Eq.
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:H-evolve-matrix"

\end_inset

 is computed from derivatives of 
\begin_inset Formula $\Upsilon_{\theta}$
\end_inset

 due to 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:ck-derivative"

\end_inset

,
\begin_inset Formula 
\begin{equation}
\frac{\partial\Upsilon_{\theta}}{\partial\theta}=\begin{cases}
{\displaystyle \sigma(w_{l}x+b_{l})} & \theta=a_{l}\\
a_{l}\sigma'(w_{l}x+b_{l}) & \theta=b_{l}\\
a_{l}\sigma'(w_{l}x+b_{l})x & \theta=w_{l}
\end{cases}\quad l=1,\ldots,L.\label{eq:upsilon-derivative}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The smoothness of
\begin_inset Formula $\sigma(x)$
\end_inset

 determines the smoothness of 
\begin_inset Formula $\frac{\partial\Upsilon_{\theta}}{\partial\theta}$
\end_inset

 and hence the decaying speed of 
\begin_inset Formula $\frac{\partial c_{k}(\theta)}{\partial\theta}$
\end_inset

 along 
\begin_inset Formula $k$
\end_inset

.
 Notably there are two common cases:
\end_layout

\begin_layout Subparagraph
Case 1
\end_layout

\begin_layout Standard
\begin_inset Formula $\sigma(x)$
\end_inset

 is analytical in a neighborhood of 
\begin_inset Formula $[-1,1]$
\end_inset

 in complex plane (in the sense of Lemma 
\begin_inset CommandInset ref
LatexCommand ref
reference "lem:cheb-coef-analytical"

\end_inset

), so 
\begin_inset Formula $\Upsilon_{\theta}(x)$
\end_inset

 and 
\begin_inset Formula $\frac{\partial\Upsilon_{\theta}(x)}{\partial\theta}$
\end_inset

 are analytical also.
 Let's further assume that there is no singularity in a neighborhood of
 the real axis 
\begin_inset Foot
status open

\begin_layout Plain Layout
If there is singularity on the real axis, then it will be non-smooth with
 certain translation parameter 
\begin_inset Formula $b_{l}$
\end_inset

.
 The estimation of 
\begin_inset Formula $\Theta$
\end_inset

 will be more complicated and problem dependent.
\end_layout

\end_inset

 for the domain of 
\begin_inset Formula $\sigma(x)$
\end_inset

 in complex plane.
 i.e.
 the nearest singularity is 
\begin_inset Formula $\pm\mathrm{i}B$
\end_inset

 (
\begin_inset Formula $B>0$
\end_inset

) away from the real axis.
 In this setup, the Bernstein ellipse parameter 
\begin_inset Foot
status open

\begin_layout Plain Layout
The 
\begin_inset Formula $\Theta$
\end_inset

 is the 
\begin_inset Formula $\rho$
\end_inset

 in lemma 
\begin_inset CommandInset ref
LatexCommand ref
reference "lem:cheb-coef-analytical"

\end_inset

, not to be confused with the weighting 
\begin_inset Formula $\rho(x)$
\end_inset

.
\end_layout

\end_inset

 is 
\begin_inset Formula $\Theta_{\sigma(x)}\geq B+\sqrt{1+B^{2}}$
\end_inset

.
\end_layout

\begin_layout Standard
So the Bernstein ellipse parameter for 
\begin_inset Formula $\frac{\partial\Upsilon_{\theta}}{\partial\theta}$
\end_inset

 is 
\begin_inset Formula $\Theta_{\sigma(w_{l}x)}=B/w_{l}+\sqrt{1+\left(B/w_{l}\right)^{2}}$
\end_inset

, we get
\begin_inset Formula 
\begin{align}
\left|\frac{\partial c_{k}(\theta)}{\partial\theta}\right| & <2M\Theta_{\sigma(w_{l}x)}^{-k}=2M\left(B/w_{l}+\sqrt{1+\left(B/w_{l}\right)^{2}}\right)^{-k},\quad k\geq1\label{eq:c-decay-exp}\\
 & \approx2M\left(\Theta_{\sigma(x)}/w_{l}\right)^{-k}\quad(\textrm{when}\ w_{l}\ll B)
\end{align}

\end_inset


\end_layout

\begin_layout Subparagraph
Case 2
\end_layout

\begin_layout Standard
\begin_inset Formula $\sigma(x)$
\end_inset

 is continuous up to 
\begin_inset Formula $(\nu-1)$
\end_inset

-th derivative (in the sense of Lemma 
\begin_inset CommandInset ref
LatexCommand ref
reference "lem:cheb-coef-cn"

\end_inset

), so 
\begin_inset Formula $\Upsilon_{\theta}(x)$
\end_inset

 and 
\begin_inset Formula $\frac{\partial\Upsilon_{\theta}(x)}{\partial\theta}$
\end_inset

 are continuous up to 
\begin_inset Formula $(\tilde{\nu}-1)$
\end_inset

-th derivative, with 
\begin_inset Formula $\tilde{\nu}=\nu-1$
\end_inset

 for 
\begin_inset Formula $\theta=b_{l}\textrm{ and }w_{l}$
\end_inset

, or 
\begin_inset Formula $\tilde{\nu}=\nu$
\end_inset

 for 
\begin_inset Formula $\theta=a_{l}$
\end_inset

.
 By lemma 
\begin_inset CommandInset ref
LatexCommand ref
reference "lem:cheb-coef-cn"

\end_inset

, we have upper bound
\begin_inset Formula 
\begin{equation}
\left|\frac{\partial c_{k}(\theta)}{\partial\theta}\right|\leq\frac{2V}{\pi(k-\tilde{\nu})^{\tilde{\nu}+1}}\quad(\forall k>\tilde{\nu}).\label{eq:c-decay-power}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Graded Matrix
\begin_inset CommandInset label
LatexCommand label
name "subsec:Graded-Matrix"

\end_inset


\end_layout

\begin_layout Standard
Both Eq.
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:c-decay-exp"

\end_inset

 and Eq.
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:c-decay-power"

\end_inset

 show the decay of 
\begin_inset Formula $\left|\frac{\partial c_{k}(\theta)}{\partial\theta}\right|$
\end_inset

 with respect to 
\begin_inset Formula $k$
\end_inset

.
 Thus the matrix Eq.
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:H-evolve-matrix"

\end_inset

 will also have certain decaying property.
 Specifically, there exist symmetric matrix 
\begin_inset Formula $B$
\end_inset

 of bounded spectral norm and diagonal matrix 
\begin_inset Formula $D$
\end_inset

 such that
\begin_inset Formula 
\begin{equation}
H=DBD\label{eq:grad-decompose}
\end{equation}

\end_inset

where matrix 
\begin_inset Formula $D$
\end_inset

 can be defined as 
\begin_inset Formula $D=\mathrm{diag}(\left[\Theta_{\sigma(\max(w_{l})x)}^{-k}\right]_{k\in\mathbb{N}_{0}})$
\end_inset

 or 
\begin_inset Formula $D=\mathrm{diag}(\left[(k+1)^{\min(v)-1}\right]_{k\in\mathbb{N}_{0}})$
\end_inset

, depending on the smoothness of 
\begin_inset Formula $\sigma(x)$
\end_inset

.
 Or, a more straightforward way is to define 
\begin_inset Formula $D=\mathrm{diag}(\left[H_{kk}\right]_{k\in\mathbb{N}_{0}})$
\end_inset

.
 And 
\begin_inset Formula $B=D^{-1}HD^{-1}$
\end_inset

 where pseudo-inverse of 
\begin_inset Formula $D$
\end_inset

 is used if necessary.
 In the later definition of 
\begin_inset Formula $D$
\end_inset

, it is easy to show that 
\begin_inset Formula $D_{kk}=O(\Theta_{\sigma(\max(w_{l})x)}^{-k})$
\end_inset

 or 
\begin_inset Formula $D_{kk}=O(k^{-\min(\tilde{\nu})-1})$
\end_inset

.
\end_layout

\begin_layout Standard
For matrix that has structure Eq.
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:grad-decompose"

\end_inset

, due to Min-max theorem of eigenvalues, we have
\begin_inset Formula 
\begin{equation}
\lambda_{k}(H)\leq D_{kk}^{2}\lambda_{\textrm{max}}(B)\quad\forall k\in\mathbb{N}\label{eq:H-eigval-decay}
\end{equation}

\end_inset

where 
\begin_inset Formula $\lambda_{k}(H)$
\end_inset

 is the 
\begin_inset Formula $k$
\end_inset

-th eigenvalue of 
\begin_inset Formula $H$
\end_inset

 sorting in descending order.
\end_layout

\begin_layout Standard
And if 
\begin_inset Formula $\lambda_{\min}(B)>C>0$
\end_inset

, then the eigenvectors of 
\begin_inset Formula $H$
\end_inset

 are close to unit vector.
\end_layout

