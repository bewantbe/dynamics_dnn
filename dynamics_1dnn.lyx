\lambda_{\textrm{max}}(\tilde{H}_{L(\theta)}-H_{L(\theta)})\leq
\]

\end_inset


\begin_inset Formula 
\[
\mathbb{E}\left(\left\Vert \tilde{H}_{L(\theta)}-H_{L(\theta)}\right\Vert _{F}^{2}\right)=\frac{1}{J}\left(\mathrm{tr}(H_{L(\theta)}^{2})+\mathrm{tr^{2}}(H_{L(\theta)})\right)
\]

