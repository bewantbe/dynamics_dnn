\end_inset


\end_layout

\begin_layout Standard
For the empirical hessian 
\begin_inset Formula $\tilde{H}_{L(\theta)}\triangleq\nabla_{\theta}\otimes\nabla_{\theta}\tilde{L}_{J}(\theta)$
\end_inset


\begin_inset Formula 
\[
\tilde{H}_{L(\theta)}=\frac{1}{J}\sum_{j=1}^{J}\left(\left[\frac{\partial\Upsilon_{\theta}(x_{j})}{\partial\theta}\right]^{T}\cdot\left[\frac{\partial\Upsilon_{\theta}(x_{j})}{\partial\theta}\right]+(\Upsilon_{\theta}(x_{j})-y(x_{j}))\nabla_{\theta}\otimes\nabla_{\theta}\Upsilon_{\theta}(x_{j})\right).
\]

\end_inset


\end_layout

\begin_layout Standard
Due to the Weyl's inequality, we have
\begin_inset Formula 
\begin{equation}
\lambda_{k}(H_{L(\theta)})+\lambda_{\textrm{min}}(\tilde{H}_{L(\theta)}-H_{L(\theta)})\leq\lambda_{k}(\tilde{H}_{L(\theta)})\leq\lambda_{k}(H_{L(\theta)})+\lambda_{\textrm{max}}(\tilde{H}_{L(\theta)}-H_{L(\theta)})
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
We have
\begin_inset Formula 
\[
\lambda_{\textrm{max}}(\tilde{H}_{L(\theta)}-H_{L(\theta)})\leq\left\Vert \tilde{H}_{L(\theta)}-H_{L(\theta)}\right\Vert _{F}\leq\frac{C}{\sqrt{J}}\left(3L\right)^{2}
\]

\end_inset

-> Not so useful....
\end_layout

