\begin_layout Subsection
Hessian of Loss Function
\end_layout

\begin_layout Standard
The hessian of loss function is
\begin_inset Formula 
\begin{equation}
\frac{\partial L(\theta)}{\partial\theta}=\int_{\Omega}(\Upsilon_{\theta}(x)-y(x))\frac{\partial\Upsilon_{\theta}(x)}{\partial\theta}\rho(x)\,\mathrm{d}x
\end{equation}

\end_inset


\begin_inset Formula 
\begin{equation}
\nabla_{\theta}\otimes\nabla_{\theta}L(\theta)=\int_{\Omega}\left(\left[\frac{\partial\Upsilon_{\theta}(x)}{\partial\theta}\right]^{T}\cdot\left[\frac{\partial\Upsilon_{\theta}(x)}{\partial\theta}\right]+(\Upsilon_{\theta}(x)-y(x))\nabla_{\theta}\otimes\nabla_{\theta}\Upsilon_{\theta}(x)\right)\rho(x)\,\mathrm{d}x
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Define
\begin_inset Formula 
\begin{equation}
H_{L(\theta)}\triangleq\int_{\Omega}\left[\frac{\partial\Upsilon_{\theta}(x)}{\partial\theta}\right]^{T}\cdot\left[\frac{\partial\Upsilon_{\theta}(x)}{\partial\theta}\right]\rho(x)\,\mathrm{d}x.
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
When the 
\begin_inset Formula $\theta$
\end_inset

 reach the global optimal solution, i.e.
 
\begin_inset Formula $\Upsilon_{\theta}(x)\equiv y(x)$
\end_inset

.
 The hessian become
\begin_inset Formula 
\begin{equation}
\nabla_{\theta}\otimes\nabla_{\theta}L(\theta^{*})=H_{L(\theta^{*})}.
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
When writting in terms of GFS,
\begin_inset Formula 
\[
\frac{\mathrm{d}^{2}L(\theta)}{\mathrm{d}\theta_{i}\mathrm{d}\theta_{j}}=\left\langle \frac{\partial\Upsilon_{\theta}(x)}{\partial\theta_{i}},\frac{\partial\Upsilon_{\theta}(x)}{\partial\theta_{j}}\right\rangle _{\rho}=\sum_{k=0}^{\infty}\frac{\partial c_{k}(\theta)}{\partial\theta_{i}}\cdot\frac{\partial c_{k}(\theta)}{\partial\theta_{j}},
\]

\end_inset

we have
\begin_inset Formula 
\begin{equation}
H_{L(\theta)}=\left[\frac{\partial c_{k}(\theta)}{\partial\theta}\right]_{k\in\mathbb{N}_{0}}^{T}\left[\frac{\partial c_{k}(\theta)}{\partial\theta}\right]_{k\in\mathbb{N}_{0}}.\label{eq:loss-optimal-H}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The matrix 
\begin_inset Formula $H_{L(\theta)}$
\end_inset

 and 
\begin_inset Formula $H_{c(\theta)}$
\end_inset

 (Eq.
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:H-evolve-matrix"

\end_inset

) are differed only by the multiplication order of the transposed matrix,
 therefore they have exactly the same eigenvalues.
 For simplicity, define 
\begin_inset Formula $\lambda_{k}=0$
\end_inset

 when 
\begin_inset Formula $k$
\end_inset

 exceed corresponding matrix dimension.
\begin_inset Formula 
\begin{equation}
\lambda_{k}(H_{L(\theta)})=\lambda_{k}(H_{c(\theta)})\quad(\forall k\in\mathbb{N})\label{eq:eigval-HL-H}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Thus from Sec.
 
\begin_inset CommandInset ref
LatexCommand ref
reference "subsec:Graded-Matrix"

\end_inset

 we know that the landscape of loss is extremely flat due to the vast near
 zero eigenvalues as shown in Eq.
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:H-eigval-decay"

\end_inset

.
\end_layout

\begin_layout Standard
