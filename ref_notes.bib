	doi = {10.1017/S0266466600011129},
	abstract = {Let X0 be a square matrix (complex or otherwise) and u0 a (normalized) eigenvector associated with an eigenvalue $\lambda$o of X0, so that the triple (X0, u0, $\lambda$0) satisfies the equations Xu = $\lambda$u, . We investigate the conditions under which unique differentiable functions $\lambda$(X) and u(X) exist in a neighborhood of X0 satisfying $\lambda$(X0) = $\lambda$O, u(X0) = u0, Xu = $\lambda$u, and . We obtain the first and second derivatives of $\lambda$(X) and the first derivative of u(X). Two alternative expressions for the first derivative of $\lambda$(X) are also presented.},
